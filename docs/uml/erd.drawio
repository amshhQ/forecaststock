ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;fontSize=11;" edge="1" parent="1" source="t_users" target="t_categories"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r2" value="memiliki" style="exitX=1;exitY=0.85;entryX=0;entryY=0.3;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;fontSize=11;" edge="1" parent="1" source="t_users" target="t_products"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r3" value="memiliki" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;fontSize=11;" edge="1" parent="1" source="t_users" target="t_scenarios"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r4" value="mengelompokkan" style="exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERzeroToOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;fontSize=11;" edge="1" parent="1" source="t_categories" target="t_products"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r5" value="tercatat dalam" style="exitX=1;exitY=0.3;entryX=0;entryY=0.3;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;fontSize=11;" edge="1" parent="1" source="t_products" target="t_sales"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Catatan:&lt;br&gt;• Notasi crow's foot. PK = primary key, FK = foreign key, UQ = unique.&lt;br&gt;• Satu baris sales = jumlah terjual satu produk dalam satu minggu (week_start = tanggal awal minggu).&lt;br&gt;• Prediksi Trend Moment dan rekomendasi stok dihitung saat diminta, tidak disimpan di tabel.&lt;br&gt;• Tabel bawaan Laravel (password_reset_tokens, sessions, cache, jobs, personal_access_tokens) tidak ditampilkan." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1100" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
